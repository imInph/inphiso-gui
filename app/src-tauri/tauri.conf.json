{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inphiso",
  "version": "0.1.0",
  "identifier": "com.inphner.inphiso",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs --debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "inphiso",
        "width": 960,
        "height": 600,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Flash Windows and Linux images to USB drives",
    "copyright": "\u00a9 2026 imInph",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/inphiso-helper"
    ]
  }
}
