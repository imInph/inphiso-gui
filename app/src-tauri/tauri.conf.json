{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inphiso",
  "version": "1.0.0",
  "identifier": "com.inphner.inphiso",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs --debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "inphiso",
        "width": 960,
        "height": 600,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Flash Windows and Linux images to USB drives",
    "copyright": "© 2026 imInph",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/inphiso-helper"
    ],
    "publisher": "imInph",
    "homepage": "https://github.com/imInph/inphiso-gui",
    "license": "GPL-3.0-or-later",
    "longDescription": "Flash Windows and Linux disk images to USB drives. Handles Windows installer ISOs (FAT32 with a split install.wim), compressed images, checksums and verification.",
    "resources": {
      "../../LICENSE": "LICENSE"
    },
    "windows": {
      "nsis": {
        "template": "../../installer/windows/installer.nsi",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "../../installer/windows/header.bmp",
        "sidebarImage": "../../installer/windows/splash.bmp",
        "startMenuFolder": "inphiso"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "../../installer/macos/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 165,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 190
        }
      }
    },
    "linux": {
      "deb": {
        "recommends": [
          "wimtools",
          "pkexec | policykit-1"
        ],
        "files": {
          "/usr/share/polkit-1/actions/com.inphner.inphiso.policy": "../../installer/linux/com.inphner.inphiso.policy"
        },
        "section": "utils"
      },
      "rpm": {
        "recommends": [
          "wimlib-utils",
          "polkit"
        ],
        "files": {
          "/usr/share/polkit-1/actions/com.inphner.inphiso.policy": "../../installer/linux/com.inphner.inphiso.policy"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
