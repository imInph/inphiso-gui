# Maintainer: imInph <inph at inphner dot com>
#
# Builds inphiso from source. The AUR workflow (.github/workflows/aur.yml)
# sets pkgver and the checksum on each release.

pkgname=inphiso
pkgver=0.1.0
pkgrel=1
pkgdesc="Flash Windows and Linux disk images to USB drives"
arch=('x86_64' 'aarch64')
url="https://github.com/imInph/inphiso-gui"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'polkit' 'gcc-libs' 'glibc')
makedepends=('cargo' 'nodejs' 'npm' 'pkgconf')
optdepends=('wimlib: flash Windows ISOs whose install.wim is over 4 GB')
provides=('inphiso')
conflicts=('inphiso-bin')
# Rust does its own LTO; makepkg's LTO flags break the C parts of some crates.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir() {
  echo "$srcdir/inphiso-gui-$pkgver"
}

prepare() {
  cd "$(_srcdir)/app"
  npm ci --no-audit --no-fund
}

build() {
  cd "$(_srcdir)/app"
  export CARGO_HOME="$srcdir/cargo-home"
  # Builds the frontend, the helper (into target/<triple>/release) and the app,
  # without making .deb/.rpm/AppImage bundles.
  npx tauri build --no-bundle
}

package() {
  cd "$(_srcdir)"
  local triple
  triple=$(rustc -vV | sed -n 's/^host: //p')

  install -Dm755 target/release/inphiso-app "$pkgdir/usr/bin/inphiso"
  install -Dm755 "target/$triple/release/inphiso-helper" "$pkgdir/usr/bin/inphiso-helper"
  install -Dm644 installer/linux/com.inphner.inphiso.policy \
    "$pkgdir/usr/share/polkit-1/actions/com.inphner.inphiso.policy"
  install -Dm644 installer/linux/inphiso.desktop "$pkgdir/usr/share/applications/inphiso.desktop"
  install -Dm644 app/src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/inphiso.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
